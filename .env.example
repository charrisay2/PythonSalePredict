# ===================== App =====================
APP_NAME=Demand Forecasting Platform
ENVIRONMENT=development
SECRET_KEY=change-me-to-a-long-random-string-at-least-32-chars
ACCESS_TOKEN_EXPIRE_MINUTES=720
# Danh sach origin duoc phep (phan cach bang dau phay)
BACKEND_CORS_ORIGINS=http://localhost:8501,http://127.0.0.1:8501

# cái này tôi xài postgree hen
DATABASE_URL=postgresql+psycopg2://demand:demand@localhost:5432/demand_forecast


FIRST_ADMIN_EMAIL=admin@example.com
FIRST_ADMIN_PASSWORD=Admin@12345
FIRST_ADMIN_NAME=System Administrator

# ===================== LLM (AI giai thich) =====================
# none | openai | anthropic   (neu = none hoac thieu API key -> dung fallback rule-based)
LLM_PROVIDER=none
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-latest
LLM_TIMEOUT_SECONDS=45
#chỗ này cài con LLM nhen


# ===================== Frontend =====================
API_BASE_URL=http://localhost:8000
